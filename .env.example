# Copy this file to .env and fill in your keys.
# .env is gitignored; this template holds NO real values and is safe to commit.

# OpenRouter — LLM that parses prompts, selects venues, and interprets swaps.
OPENROUTER_API_KEY=

# Google Maps Platform server keys. Use a separately API-restricted key for
# each service in production.
# Places API (New) — venue search
GOOGLE_PLACES_API_KEY=
# Geocoding API — city and starting-address resolution
GOOGLE_GEOCODING_API_KEY=
# Routes API — transit / walk legs
GOOGLE_ROUTES_API_KEY=
# Weather API — hourly forecast
GOOGLE_WEATHER_API_KEY=
# Maps JavaScript API — browser map tiles. This key and the six Firebase Web
# config values below are deliberately browser-side; restrict the Maps referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Firebase Web config — public client configuration, not server secrets.
# Set all six together to enable Google sign-in and anonymous guest identity.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — SERVER-SIDE SECRETS from the same project's service account.
# Never prefix these with NEXT_PUBLIC_ or expose them to the browser.
# All three are required for verified ownership/resume/history/personalization;
# without them sign-in can appear to work, but the server treats callers as guests.
# PRIVATE_KEY accepts a PEM with real newlines or literal \n escapes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional public build-time flag. Development controls are visible in local
# development, but production omits them unless this is exactly "true".
# Changing it requires a rebuild/redeploy.
NEXT_PUBLIC_ENABLE_DEV_CONTROLS=false
