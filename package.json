{
  "name": "itinerary",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx scripts/run-unit-tests.ts",
    "test:e2e": "tsx scripts/run-mock-e2e.ts",
    "test:e2e:headed": "tsx scripts/run-mock-e2e.ts --headed",
    "test:e2e:live": "playwright test --config playwright.live.config.ts --grep-invert @mock",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "luxon": "^3.7.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/google.maps": "^3.65.2",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "tsx": "4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    },
    "jose": "^5.10.0"
  }
}
